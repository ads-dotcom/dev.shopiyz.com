        ],
        [
          "products:write"
        ]
      ],
      "nativePermissions": [
        "products:manage"
      ],
      "readOnly": true,
      "idempotencyRequired": false,
      "queryParameters": [
        "search",
        "status",
        "tab",
        "currency",
        "issueMethod",
        "sort",
        "limit",
        "offset",
        "balance",
        "value",
        "valueOperator",
