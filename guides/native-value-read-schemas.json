  "operations": [
    {
      "method": "GET",
      "path": "/customers/{customer_id}/store_credit/native.json",
      "responseSchema": "NativeCustomerCreditWalletResponse",
      "scopeAlternatives": [
        [
          "admin:read"
        ],
        [
          "admin:write"
        ],
        [
          "customers:read"
        ],
        [
          "customers:write"
        ]
      ],
      "nativePermissions": [
        "customers:manage"
      ],
      "readOnly": true,
      "idempotencyRequired": false,
      "queryParameters": [
        "currency"
      ]
    },
    {
      "method": "GET",
      "path": "/gift_cards/native.json",
      "responseSchema": "NativeGiftCardListResponse",
      "scopeAlternatives": [
