{
  "description": "Read-only Native value and loyalty workspace parity. Linked current Native staff required; no schema installation, financial adjustment, policy mutation or notification delivery.",
  "schemas": {
    "NativeCustomerCreditWallet": {
      "type": "object",
      "properties": {
        "storeId": {
          "type": "string"
        },
        "customerId": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "balanceMinor": {
          "type": "integer"
        },
        "reservedMinor": {
          "type": "integer"
        },
        "availableMinor": {
          "type": "integer"
        },
        "expiredMinor": {
          "type": "integer"
        },
        "revision": {
          "type": "integer"
        },
        "initialized": {
          "type": "boolean"
        },
        "lots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "remaining_minor": {
                "type": "integer"
              },
              "reserved_minor": {
                "type": "integer"
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "created_at": {
                "type": "string"
              }
            }
          }
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "delta_minor": {
                "type": "integer"
              },
              "reserved_delta_minor": {
                "type": "integer"
              },
              "balance_after_minor": {
                "type": "integer"
              },
              "order_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reference_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "created_at": {
                "type": "string"
              }
            }
          }
        },
        "legacyHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "amount": {
                "type": "number"
              },
              "currency": {
                "type": "string"
              },
              "balance_after": {
                "type": "number"
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "created_at": {
                "type": "string"
              },
              "order_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "required": [
        "storeId",
        "customerId",
        "currency",
        "balanceMinor",
        "reservedMinor",
        "availableMinor",
        "expiredMinor",
        "revision",
        "initialized",
        "lots",
        "history",
        "legacyHistory"
      ],
      "description": "Canonical Native wallet. Camel-case Minor fields and movement/lot *_minor fields are exact currency minor units; legacyHistory amount/balance_after retain their stored major-unit values. Reads do not initialize accounts or reconcile expiry."
    },
    "NativeCustomerCreditWalletResponse": {
      "type": "object",
      "properties": {
        "wallet": {
          "$ref": "#/components/schemas/NativeCustomerCreditWallet"
        },
        "actorId": {
          "type": "string",
          "description": "Current Native creator; rechecked before returning the read."
        },
        "expiryTimeZone": {
          "type": [
            "string",
            "null"
          ],
          "description": "Validated store IANA timezone, or null. No invented expiry timezone."
        },
        "permissions": {
          "type": "object",
          "properties": {
            "credit": {
              "type": "boolean"
            },
            "debit": {
              "type": "boolean"
            },
            "refund": {
              "type": "boolean"
            }
          },
          "required": [
            "credit",
            "debit",
            "refund"
          ],
          "additionalProperties": false,
          "description": "Current Native panel permissions only; not token scopes or API money-command availability."
        }
      },
      "required": [
        "actorId",
        "expiryTimeZone",
        "wallet",
        "permissions"
      ]
    },
